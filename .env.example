# Set this to the verified public origin before a production build.
# NEXT_PUBLIC_SITE_URL=https://your-approved-domain.example

# Public API Gateway URL, baked into the static export at build time.
# No AWS credentials or recipient addresses belong in NEXT_PUBLIC_* variables.
# NEXT_PUBLIC_CONTACT_API_URL=https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com/contact
